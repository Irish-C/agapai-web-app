generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = "5"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        BigInt @id @default(autoincrement())
  role_name String @unique @db.VarChar(50)
  users     User[]

  @@map("roles")
}

model User {
  id                  BigInt     @id @default(autoincrement())
  firstname           String     @db.VarChar(100)
  middle_name         String?    @db.VarChar(100)
  lastname            String     @db.VarChar(100)
  birthdate           DateTime
  email               String     @unique @db.VarChar(255)
  username            String     @unique @db.VarChar(50)
  password            String     @db.VarChar(255)
  is_active           Boolean    @default(true)
  role_id             BigInt?
  email_notifications Boolean    @default(false)
  alert_threshold     Int        @default(0)
  acknowledged_logs   EventLog[]
  role                Role?      @relation(fields: [role_id], references: [id])

  @@map("users")
}

model Location {
  id       BigInt     @id @default(autoincrement())
  loc_name String     @unique @db.VarChar(100)
  events   EventLog[]

  @@map("location")
}

model CameraConfig {
  id         Int      @id @unique @default(1)
  cam_name   String   @db.VarChar(100)
  stream_url String   @db.VarChar(255)
  loc_id     BigInt?
  status     String   @default("active") @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt

  @@map("camera_config")
}

model EventType {
  id              BigInt       @id @default(autoincrement())
  event_type_name String       @unique @db.VarChar(50)
  classes         EventClass[]

  @@map("event_type")
}

model EventClass {
  id            BigInt     @id @default(autoincrement())
  class_name    String     @db.VarChar(100)
  event_type_id BigInt
  event_type    EventType  @relation(fields: [event_type_id], references: [id])
  logs          EventLog[]

  @@map("event_class")
}

model GlobalSetting {
  id         BigInt  @id @default(autoincrement())
  ai_enabled Boolean @default(true)

  @@map("global_settings")
}

model Snapshot {
  id           BigInt   @id @default(autoincrement())
  filename     String   @db.VarChar(255)
  timestamp    DateTime @default(now()) @db.Timestamp(6)
  event_log_id BigInt
  event_log    EventLog @relation(fields: [event_log_id], references: [id], onDelete: Cascade)

  @@map("snapshots")
}

model EventLog {
  id              BigInt      @id @default(autoincrement())
  timestamp       DateTime    @default(now()) @db.Timestamp(6)
  event_status    String      @default("unacknowledged") @db.VarChar(50)
  file_path       String?     @db.VarChar(255)
  event_class_id  BigInt?
  ack_by_user_id  BigInt?
  deleted_at      DateTime?   @db.Timestamp(6)
  location_id     BigInt?
  acknowledged_by User?       @relation(fields: [ack_by_user_id], references: [id])
  event_class     EventClass? @relation(fields: [event_class_id], references: [id])
  location        Location?   @relation(fields: [location_id], references: [id], onUpdate: NoAction)
  snapshots       Snapshot[]

  @@map("event_logs")
}
