generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
  interface           = "asyncio"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        BigInt @id @default(autoincrement())
  role_name String @unique @db.VarChar(50)
  users     User[]

  @@map("roles")
}

model User {
  id                BigInt     @id @default(autoincrement())
  firstname         String     @db.VarChar(100)
  middle_name       String?    @db.VarChar(100)
  lastname          String     @db.VarChar(100)
  birthdate         DateTime
  email             String     @unique @db.VarChar(255)
  username          String     @unique @db.VarChar(50)
  password          String     @db.VarChar(255)
  is_active         Boolean    @default(true)
  role_id           BigInt?
  acknowledged_logs EventLog[]
  role              Role?      @relation(fields: [role_id], references: [id])
  
  email_notifications Boolean @default(false)
  alert_threshold     Int     @default(0)

  @@map("users")
}

model Location {
  id       BigInt   @id @default(autoincrement())
  loc_name String   @unique @db.VarChar(100)
  cameras  Camera[]

  @@map("location")
}

model EventType {
  id              BigInt       @id @default(autoincrement())
  event_type_name String       @unique @db.VarChar(50)
  classes         EventClass[]

  @@map("event_type")
}

model EventClass {
  id            BigInt     @id @default(autoincrement())
  class_name    String     @db.VarChar(100)
  event_type_id BigInt
  event_type    EventType  @relation(fields: [event_type_id], references: [id])
  logs          EventLog[]

  @@map("event_class")
}

model Camera {
  id         BigInt     @id @default(autoincrement())
  cam_name   String     @db.VarChar(100)
  cam_status Boolean    @default(true)
  stream_url String     @db.VarChar(255)
  loc_id     BigInt?
  location   Location?  @relation(fields: [loc_id], references: [id])
  logs       EventLog[]

  @@map("camera")
}

// Global settings for feature toggles
model GlobalSetting {
  id                  BigInt  @id @default(autoincrement())
  ai_enabled          Boolean @default(true)  // Toggle to enable/disable activity detection

  @@map("global_settings")
}

model Snapshot {
  id           BigInt    @id @default(autoincrement())
  filename     String    @db.VarChar(255)  // e.g., "cam9_charbel_20260418_1901.jpg"
  timestamp    DateTime  @default(now()) @db.Timestamp(6)
  event_log_id BigInt
  event_log    EventLog  @relation(fields: [event_log_id], references: [id], onDelete: Cascade)

  @@map("snapshots")
}

model EventLog {
  id              BigInt      @id @default(autoincrement())
  timestamp       DateTime    @default(now()) @db.Timestamp(6)
  event_status    String      @default("unacknowledged") @db.VarChar(50)
  file_path       String?     @db.VarChar(255)  // DEPRECATED: for backward compatibility only
  cam_id          BigInt?
  event_class_id  BigInt?
  ack_by_user_id  BigInt?
  deleted_at      DateTime?   @db.Timestamp(6)  // Soft delete timestamp
  acknowledged_by User?       @relation(fields: [ack_by_user_id], references: [id])
  camera          Camera?     @relation(fields: [cam_id], references: [id])
  event_class     EventClass? @relation(fields: [event_class_id], references: [id])
  snapshots       Snapshot[]  // NEW: Track individual snapshots

  @@map("event_logs")
}
