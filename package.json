{
  "name": "agapai-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client": "cd client && vite --host",
    "server": "cd server && DEVICE=GPU OPENVINO_DEVICE=HETERO:GPU,CPU ./venv/bin/python -m uvicorn app:asgi_app --reload --port 5000",
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "ai": "cd ai_service && ./venv/bin/python app.py",
    "build:ai-css": "AI_SERVICE_BUILD=true postcss ai_service/styles.css -o ai_service/static/tailwind.css --config postcss.config.js && echo '[✓] AI Service CSS built: ai_service/static/tailwind.css'",
    "build:ai-css:watch": "AI_SERVICE_BUILD=true postcss ai_service/styles.css -o ai_service/static/tailwind.css --config postcss.config.js --watch",
    "db:setup": "cd server && ./venv/bin/prisma py migrate deploy && ./venv/bin/prisma py generate",
    "db:migrate": "cd server && ./venv/bin/prisma py migrate deploy",
    "db:generate": "cd server && ./venv/bin/prisma py generate",
    "db:studio": "cd server && npx prisma studio",
    "db:reset": "cd server && ./venv/bin/prisma py db reset",
    "db:seed": "cd server && ./venv/bin/python scripts/seed_db.py",
    "prisma:generate": "cd server && ./venv/bin/prisma py generate",
    "db:clear-logs": "cd server && ./venv/bin/python scripts/clear_logs.py",
    "prisma:generate:node": "cd server && npx prisma generate --schema=./server/prisma/schema.prisma",
    "build": "npm run build:ai-css && vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js"
  },
  "dependencies": {
    "@prisma/client": "5.17.0",
    "axios": "^1.13.2",
    "dotenv": "^17.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prisma": "5.17.0",
    "tailwindcss": "^4.2.4",
    "vite": "^7.1.12"
  },
  "overrides": {
    "hono": "4.11.7"
  }
}
