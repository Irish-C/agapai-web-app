# dotenv example for local development
# Copy this to .env and adjust values as needed.

# The backend expects this URL to connect to the local Postgres database.
# See server/scripts/setup_dev_db.sh for a helper that creates the DB and user.
DATABASE_URL="postgresql://devuser:devpass@localhost:5432/agapai_db"

# Frontend dev server config
VITE_API_URL=http://127.0.1.1:5000
