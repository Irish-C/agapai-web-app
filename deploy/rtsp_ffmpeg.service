[Unit]
Description=RTSP->/detect ffmpeg poster for camera
After=network.target

[Service]
Type=simple
# Point EnvironmentFile to your copied env file (edit path as needed)
EnvironmentFile=/home/agapai/agapai-web-app/scripts/rtsp_ffmpeg.env
# ExecStart should point to the wrapper script in the repository (edit path if different)
ExecStart=/home/agapai/agapai-web-app/scripts/rtsp_ffmpeg_loop.sh
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=30
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=multi-user.target
