# dotenv example with separate sections for local dev and Docker runtime.
# Copy the appropriate block to `.env.local` (local dev) or `.env.docker` (docker)
# and update values. DO NOT commit real secrets into source control.

########## Local development (.env.local) ##########
# Use when running the server in a host venv on your machine.
# Local DB typically runs on 127.0.0.1:5432

# Flask secret used by the backend (use a long random string)
FLASK_SECRET_KEY=change-me-please

# Postgres (local)
DATABASE_URL="postgresql://devuser:devpass@127.0.0.1:5432/agapai_db"
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agapai_db

# Redis (local)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Or use a single URL:
# REDIS_URL=redis://127.0.0.1:6379

# Prisma / migrations (set true if you want the container to run migrations)
PRISMA_MIGRATE=false

# Media/streaming host used by local services
MTX_WEBRTC_HOST=127.0.0.1

# Frontend Vite dev overrides (when running client locally)
VITE_API_URL=http://localhost:5000

########## Docker runtime (.env.docker) ##########
# Example values used by Docker Compose. These typically reference service
# hostnames defined in `docker/docker-compose.yml` (e.g. `postgres`, `redis`, `mediamtx`).
# Copy this block to `./.env.docker` when running with Docker Compose.

# Flask secret for containers (use a secure random value)
FLASK_SECRET_KEY=change-me-please

# Postgres (Docker Compose uses the postgres service hostname)
DATABASE_URL="postgresql://admin:changeme@postgres:5432/agapai_db?schema=public"
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agapai_db

# Redis (service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://redis:6379

# Let the container run migrations on startup if desired
PRISMA_MIGRATE=true

# MediaMTX service hostname
MTX_WEBRTC_HOST=mediamtx

# Vite client when served separately may still point to host:port. When
# building static assets for the image, adjust accordingly.
VITE_API_URL=http://localhost:5000

# End of example